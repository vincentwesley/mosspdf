{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagehold",
  "compatibility_date": "2026-11-19",
  // Pure static site (Workers static assets), no Worker script. Deploy locally: `npm run build && npx wrangler deploy`.
  // dist/_headers (copied from public/) applies to assets.
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
